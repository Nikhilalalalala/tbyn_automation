# Common Telegram bot settings
TELEGRAM_BOT_TOKEN=replace-me
POLLING_TIMEOUT_SECONDS=30

# Event poll workflow settings
VALIDATION_DELETE_AFTER_SECONDS=20

# Monthly summary workflow settings
GOOGLE_SHEET_ID=replace-me
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_EVENTS_RANGE=Events!A:D

# Meeting slides workflow settings
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=google-oauth-token.json
GOOGLE_MEETING_SLIDES_TEMPLATE_ID=replace-me
GOOGLE_MEETING_SLIDES_FOLDER_ID=replace-me